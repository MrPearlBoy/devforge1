# ── DevForge backend configuration ─────────────────────────────────────────
# Copy to `.env` and adjust. All values are optional — sane defaults apply.

# LLM engine: auto | openai | groq | anthropic | mock
#   auto → first provider with a key below; falls back to the deterministic
#          offline mock provider when no key is set (full pipeline still runs).
LLM_PROVIDER=auto
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3-3-70b-versatile
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Storage (relative paths resolve against the devforge/ repo root)
# DATABASE_URL=sqlite:///./devforge.db
# WORKSPACES_DIR=workspaces

# CORS (comma separated; * for local development)
CORS_ORIGINS=*

# Workflow limits
# MAX_GATE_ITERATIONS=3
# MAX_TEST_HEALS=3
# MAX_SECURITY_FIXES=2

# Execution sandbox timeouts (seconds)
# TEST_TIMEOUT=180
# SCAN_TIMEOUT=120
