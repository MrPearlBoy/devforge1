# =============================================================================
# DevForge — environment configuration
# Copy to `.env` at the repository root (or backend/.env) and adjust.
# NEVER commit a real .env file.
# =============================================================================

# ---- application ----
APP_NAME=DevForge
ENVIRONMENT=development            # development | production | test
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- security ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- database ----
# PostgreSQL (production / docker compose)
DATABASE_URL=postgresql+psycopg2://devforge:devforge@localhost:5432/devforge
# Zero-config local/SQLite alternative (used automatically by tests and demos)
# DATABASE_URL=sqlite:///./devforge.db

# ---- AI mode: live | auto ----
# live  -> real LLM calls through the configured provider
# auto  -> live if an API key is present, otherwise fail fast
DEVFORGE_MODE=live

# ---- LLM gateway (provider agnostic) ----
LLM_PROVIDER=openai            # openai | azure_openai | anthropic | openai_compatible | ollama
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                  # e.g. https://api.openai.com/v1 or your gateway
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ---- embeddings / project knowledge ----
EMBEDDING_PROVIDER=auto        # auto | openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
VECTOR_BACKEND=auto            # auto | pgvector | json

# ---- workspace (generated project files live here) ----
WORKSPACE_ROOT=./workspace

# ---- orchestration ----
MAX_STAGE_ITERATIONS=3         # max agent retry loops per stage before human intervention
MAX_TOTAL_STEPS=60             # hard guard against runaway workflows
CHECKPOINT_BACKEND=sqlite      # sqlite | memory | postgres
CHECKPOINT_PATH=./devforge.checkpoints.sqlite

# ---- code execution sandbox (never run untrusted code on the host by default) ----
EXECUTION_ENABLED=true
EXECUTION_PROVIDER=subprocess  # docker | subprocess | disabled
EXECUTION_TIMEOUT_SECONDS=120
EXECUTION_MEMORY_MB=512
EXECUTION_CPU_SECONDS=60
EXECUTION_ALLOWED_COMMANDS=python,python3,pytest,node,npm,git
DOCKER_EXECUTION_IMAGE=python:3.12-slim

# ---- GitHub integration (all remote writes require explicit human confirmation) ----
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GIT_AUTHOR_NAME=DevForge Bot
GIT_AUTHOR_EMAIL=devforge@example.com
